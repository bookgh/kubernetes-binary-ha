apiVersion: operator.tigera.io/v1
kind: Installation
metadata:
  name: default
spec:
  registry: __PRIVATE_REGISTRY__
  calicoNetwork:
    bgp: Disabled
    ipPools:
      - blockSize: 26
        cidr: __POD_CIDR__
        encapsulation: VXLAN
        natOutgoing: Enabled
        nodeSelector: all()
    nodeAddressAutodetectionV4:
      firstFound: true

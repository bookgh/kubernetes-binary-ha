[Unit]
Description=Local NGINX TCP proxy for Kubernetes API
After=network-online.target
Wants=network-online.target

[Service]
Type=forking
PIDFile=/run/nginx-k8s-api.pid
ExecStartPre=/usr/local/sbin/nginx -t -c /etc/nginx/nginx.conf
ExecStart=/usr/local/sbin/nginx -c /etc/nginx/nginx.conf
ExecReload=/usr/local/sbin/nginx -s reload -c /etc/nginx/nginx.conf
ExecStop=/usr/local/sbin/nginx -s quit -c /etc/nginx/nginx.conf
Restart=on-failure
RestartSec=3
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target

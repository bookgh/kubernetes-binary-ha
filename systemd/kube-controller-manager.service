[Unit]
Description=Kubernetes Controller Manager
After=network-online.target kube-apiserver.service

[Service]
EnvironmentFile=/etc/kubernetes/cluster.env
ExecStart=/usr/local/bin/kube-controller-manager \
  --kubeconfig=/etc/kubernetes/controller-manager.conf \
  --authentication-kubeconfig=/etc/kubernetes/controller-manager.conf \
  --authorization-kubeconfig=/etc/kubernetes/controller-manager.conf \
  --cluster-signing-cert-file=/etc/kubernetes/pki/cluster-signer.crt \
  --cluster-signing-key-file=/etc/kubernetes/pki/cluster-signer.key \
  --root-ca-file=/etc/kubernetes/pki/k8s-ca.crt \
  --service-account-private-key-file=/etc/kubernetes/pki/sa.key \
  --cluster-cidr=${POD_CIDR} \
  --allocate-node-cidrs=true \
  --leader-elect=true \
  --bind-address=0.0.0.0 \
  --secure-port=10257 \
  --v=2
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target

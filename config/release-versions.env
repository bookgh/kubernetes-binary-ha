# etcd、运行时、Harbor、pause/NodeLocal DNS 等离线资产版本及校验值；Calico/CoreDNS 版本在 cluster.env。
RELEASE_REVISION="6"
ETCD_VERSION="3.6.16"
CFSSL_VERSION="1.6.5"
HELM_VERSION="3.19.0"
DOCKER_VERSION="28.5.1"
DOCKER_COMPOSE_VERSION="2.40.3"
CRI_DOCKERD_VERSION="0.4.9"
CONTAINERD_VERSION="2.4.0"
RUNC_VERSION="1.3.3"
CNI_VERSION="v1.7.1"
CRICTL_VERSION="v1.34.0"
PAUSE_VERSION="3.10"
NODE_LOCAL_DNS_VERSION="1.27.1"
HARBOR_VERSION="2.16.0"
HARBOR_SHA256="643c137d8e829c857ef0ba45c46b5d6d8553077340bbd4929ded7e92808e77ff"
NGINX_VERSION="1.30.6"
NGINX_SHA256="3cf46f5ed7504d460125866b7bea99fb357f31d887e2e63b35503310e9b8b6c8"

# Runtime/Operator-generated images not directly represented by static workload YAML.
OFFLINE_EXTRA_IMAGE_REFS=(
  "registry.k8s.io/pause:${PAUSE_VERSION}"
  "registry.k8s.io/dns/k8s-dns-node-cache:${NODE_LOCAL_DNS_VERSION}"
  "docker.io/library/busybox:1.36.1"
)

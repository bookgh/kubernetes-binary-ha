# RPM 根包清单：dnf 从离线本地仓库解析依赖，只安装这些根包及其必需依赖。
# 部署机只需要传输和校验工具，不安装 Kubernetes 节点运行依赖。
RPM_HOST_PACKAGES=(
  curl-minimal
  openssh-clients
  rsync
  jq
  openssl
  tar
  gzip
  sshpass
  sudo
)

# 每台 Kubernetes/Harbor 节点需要的系统工具和 Kubernetes 网络依赖。
RPM_NODE_PACKAGES=(
  chrony
  curl-minimal
  wget
  openssh-clients
  tar
  gzip
  jq
  openssl
  socat
  conntrack-tools
  ipset
  ipvsadm
  iptables
  ebtables
  ethtool
  rsync
  policycoreutils-python-utils
  container-selinux
  nftables
  sshpass
  sudo
)

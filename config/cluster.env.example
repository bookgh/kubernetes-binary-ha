# 复制为 config/cluster.env，并在部署前按实际环境修改。
export K8S_VERSION="v1.37.2"
export ETCD_VERSION="v3.6.16"
export CONTAINERD_VERSION="2.4.0"
export RUNC_VERSION="1.3.3"
export CNI_PLUGINS_VERSION="v1.7.1"
export CRICTL_VERSION="v1.34.0"
export CFSSL_VERSION="1.6.5"
export HELM_VERSION="3.19.0"
export CALICOCTL_VERSION="v3.33.0"
export DOCKER_COMPOSE_VERSION="2.40.3"
export CALICO_VERSION="v3.33.0"
export COREDNS_VERSION="v1.13.1"
export ARCH="amd64"

# 容器运行时：containerd 或 docker（Docker 必须配合 cri-dockerd）
export RUNTIME_TYPE="containerd"
# Docker 模式时填写经验证的官方版本号；Docker 通过 cri-dockerd 提供 CRI。
export DOCKER_VERSION="28.5.1"
export CRI_DOCKERD_VERSION="0.4.9"
# CRI endpoint 由 RUNTIME_TYPE 自动派生，不需要手工设置。
export DOCKER_DATA_ROOT="/var/lib/docker"

# kube-proxy Service 转发模式：ipvs 或 nftables
export KUBE_PROXY_MODE="nftables"
export IPVS_STRICT_ARP="false"
export NFTABLES_MASQUERADE_BIT="14"

export CLUSTER_NAME="kubernetes"
export CLUSTER_DOMAIN="cluster.local"
export API_DNS="k8s-api.example.local"
export API_PORT="6443"
export NGINX_VERSION="1.30.6"
export POD_CIDR="10.244.0.0/16"
export SERVICE_CIDR="10.96.0.0/12"
export DNS_SERVICE_IP="10.96.0.10"
export KUBERNETES_SERVICE_IP="10.96.0.1"

# 节点清单唯一来源：前 MASTER_COUNT 个节点为 Master，其余为 Worker。
# 顺序必须先列出全部 Master，再列出全部 Worker；当前拓扑固定为 3+3。
MASTER_COUNT=3
NODE_NAMES=(
  master-01
  master-02
  master-03
  worker-01
  worker-02
  worker-03
)
NODE_IPS=(
  192.168.10.21
  192.168.10.22
  192.168.10.23
  192.168.10.41
  192.168.10.42
  192.168.10.43
)

# 离线/内网容器镜像仓库；必须可被所有集群节点访问。
export PRIVATE_REGISTRY="registry.infra.local:5000"
export COREDNS_IMAGE="registry.infra.local:5000/coredns/coredns:v1.13.1"
export PAUSE_IMAGE="registry.k8s.io/pause:3.10"

# etcd 默认参数；应在测量存储和网络延迟后再进行调整。
export ETCD_HEARTBEAT_INTERVAL="100"
export ETCD_ELECTION_TIMEOUT="1000"
export ETCD_QUOTA_BACKEND_BYTES="8589934592"

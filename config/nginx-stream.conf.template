user nginx;
worker_processes auto;
error_log /var/log/nginx-k8s-api/error.log warn;
pid /run/nginx-k8s-api.pid;
events { worker_connections 4096; }
stream {
    upstream kube_apiserver_masters {
        least_conn;
        __MASTER_UPSTREAM_SERVERS__
    }
    server {
        listen 127.0.0.1:6443;
        proxy_connect_timeout 2s;
        proxy_timeout 1h;
        proxy_pass kube_apiserver_masters;
    }
}
